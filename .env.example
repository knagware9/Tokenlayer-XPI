# Copy to .env and fill in before `docker compose up`.
# Generate a strong secret with:  openssl rand -hex 32
JWT_SECRET=

# Optional overrides (defaults shown):
# CORS_ORIGINS=http://localhost:8080
# VITE_API_URL=http://localhost:4000
# WEB_PORT=8080
# API_PORT=4000

# Real Besu chain — set automatically by the docker-compose.besu.yml overlay (make deploy).
# For a manual run against a Besu node, set both:
# BESU_RPC_URL=http://besu-node1:8545
# BESU_OPERATOR_KEY=0x…            # funded operator; never commit a production key
# Boot the API without the required besu chain (simulated-only demos): CHAIN_STRICT=0

# MST Testnet (public EVM, chainId 91562037). The 'mst' chain becomes real once these are set.
# Get test tMSTC for your operator address from the faucet: https://faucet.mstblockchain.com/
# Explorer: https://testnet.mstscan.com
# MST_RPC_URL=https://testnetrpc.mstblockchain.com
# MST_OPERATOR_KEY=0x…             # funded operator; never commit a production key
