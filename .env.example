# Copy to .env and fill in before `docker compose up`.
# Generate a strong secret with:  openssl rand -hex 32
JWT_SECRET=

# Encrypts the custodial DID seeds every organization holds (AES-256-GCM).
# Required — an organization cannot be created without it. `make deploy`
# generates one into .env when it is missing.
# NEVER ROTATE IT once organizations exist: their seeds are encrypted under the
# old key and become unrecoverable, leaving orgs that can no longer sign.
DID_MASTER_KEY=

# Optional overrides (defaults shown):
# CORS_ORIGINS=http://localhost:8080
# VITE_API_URL=http://localhost:4000
# WEB_PORT=8080
# API_PORT=4000

# Real Besu chain — set automatically by the docker-compose.besu.yml overlay (make deploy).
# For a manual run against a Besu node, set both:
# BESU_RPC_URL=http://besu-node1:8545
# BESU_OPERATOR_KEY=0x…            # funded operator; never commit a production key
# Boot the API without the required besu chain (simulated-only demos): CHAIN_STRICT=0

# MST Testnet (public EVM, chainId 91562037). The 'mst' chain becomes real once these are set.
# Get test tMSTC for your operator address from the faucet: https://faucet.mstblockchain.com/
# Explorer: https://testnet.mstscan.com
# MST_RPC_URL=https://testnetrpc.mstblockchain.com
# MST_OPERATOR_KEY=0x…             # funded operator; never commit a production key

# ── Splitting the two products ────────────────────────────────────────────────
# Which products this deployment serves. Routes belonging to a domain that is
# not listed answer 404 DOMAIN_NOT_ENABLED. Default: both.
# ENABLED_DOMAINS=tokenization,identity

# A tokenization-only deployment does not hold credentials, so it must be told
# where to ask "does this DID hold a valid KycCredential?" — that is the ONLY
# question it asks Identity, and only a DID crosses the wire (never a wallet).
# Set BOTH or NEITHER; the API refuses to boot with half of them, and refuses to
# boot with them set while ENABLED_DOMAINS still includes 'identity' (the desk
# would write credentials here while the gate read them there).
# The key is an API key minted on the IDENTITY deployment with the
# `identity:assert` scope.
# ENABLED_DOMAINS=tokenization
# IDENTITY_SERVICE_URL=https://identity.example.com/api/v1
# IDENTITY_SERVICE_KEY=tl_live_…
# IDENTITY_SERVICE_TIMEOUT_MS=5000
