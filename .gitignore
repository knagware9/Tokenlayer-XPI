node_modules/
dist/
build/
out/
coverage/
*.log
.env
.env.local
.DS_Store

# Prisma / SQLite
# `*.db*`, not `*.db`: the narrow glob matched dev.db but NOT dev.db.freshkey.bak,
# and a 233 KB local backup carrying 18 users' bcrypt hashes was committed
# through that gap. The trailing wildcard also subsumes the -journal line below.
apps/api/prisma/*.db*
apps/api/prisma/*.db-journal
*.sqlite

# Hardhat
packages/contracts/artifacts/
packages/contracts/cache/
packages/contracts/typechain-types/

# Vite
apps/web/dist/

# Fabric runtime artifacts (wallet + connection profile emitted by fabric-up.sh)
infra/fabric/.runtime/

# Local screen recordings / demo captures — never committed (large binaries)
tmp-videos/
