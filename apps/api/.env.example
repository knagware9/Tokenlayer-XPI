# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# Auth — REQUIRED. Generate a strong secret: `openssl rand -hex 32`. The server
# refuses to start without a strong, non-default JWT_SECRET.
JWT_SECRET="replace-with-output-of-openssl-rand-hex-32"

# API port
PORT=4000

# Platform fee account (address) that receives marketplace + issuance fees.
# When UNSET in production, fees are DISABLED (treated as 0) regardless of
# use-case config, so nothing breaks without it. Outside production it defaults
# to a demo address so fees are exercisable out of the box.
# PLATFORM_FEE_ACCOUNT="0xdF3e18d64BC6A983f673Ab319CCaE4f1a57C7097"

# Secondary-market escrow account (address) that holds tokens while they are
# listed for sale. When UNSET in production, ALL market endpoints (listings /
# take / cancel / trades) return 503 MARKET_DISABLED. Outside production it
# defaults to a demo address (Hardhat dev account #15, distinct from the demo
# fee account and every seeded holder/treasury) so the market works out of the box.
# MARKET_ESCROW_ACCOUNT="0xcd3B766CCDd6AE721141F452C550Ca635964ce71"

# Optional EVM chains. Each is enabled only when its RPC URL is set. EVM_OPERATOR_KEY
# is the shared default operator; per-chain keys override it. NEVER commit a real key —
# load production keys from a secrets manager / KMS. For a local Hardhat node, use that
# node's printed account key. Start a local node with: pnpm --filter @tokenlayer/contracts node
EVM_OPERATOR_KEY="0x<local-hardhat-account-private-key>"

# local-evm
# EVM_RPC_URL="http://127.0.0.1:8545"

# Hyperledger Besu (EVM)
# BESU_RPC_URL="http://127.0.0.1:8545"
# BESU_OPERATOR_KEY="0x..."
#
# Local dev against the real Besu QBFT network (host-mapped RPC). Start it first:
#   make deploy        (or: cd /Users/kamleshnagware/deposittokenization && docker compose up -d besu-node1 …node5)
# Then set (dev/demo key from the QBFT genesis — do NOT use on a real network):
# BESU_RPC_URL="http://localhost:8545"
# BESU_OPERATOR_KEY="0x8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c692be63"
# Or boot without besu (chain absent, never simulated): CHAIN_STRICT=0

# MST Testnet (public EVM, chainId 91562037; explorer https://testnet.mstscan.com).
# Fund your operator address with test tMSTC first: https://faucet.mstblockchain.com/
# The API validates the RPC reports chainId 91562037 at boot and refuses a wrong network.
# MST_RPC_URL="https://testnetrpc.mstblockchain.com"
# MST_OPERATOR_KEY="0x..."

# Hyperledger Fabric (real). Bring up the network first: `make fabric-up`, which emits
# a wallet + connection profile under infra/fabric/.runtime/ and prints these vars.
# When FABRIC_CONNECTION_PROFILE is set, the 'fabric' chain runs REAL (else simulated),
# and the API probes it at boot (fails fast if the network is down).
# FABRIC_CONNECTION_PROFILE="<repo>/infra/fabric/.runtime/connection-org1.json"
# FABRIC_WALLET="<repo>/infra/fabric/.runtime/wallet"
# FABRIC_IDENTITY="appUser"
# FABRIC_CHANNEL="mychannel"
# FABRIC_CHAINCODE="tokenlayer"

# ── Webhooks & events (EN-C) ─────────────────────────────────────────────────
# 32-byte hex key encrypting webhook signing secrets at rest (AES-256-GCM).
# UNSET falls back to DID_MASTER_KEY, so one compromise loses every custodial DID
# seed AND every integrator signing secret. Set it. But set it ONCE, BEFORE the
# first endpoint is registered: there is no key versioning and no re-encryption
# path, so changing it later makes every stored secret unopenable and every
# delivery fail until the old value is restored.
# WEBHOOK_MASTER_KEY="<openssl rand -hex 32>"

# Whether THIS process runs the delivery worker. Default on. The claim is a
# compare-and-set, so replicas cannot double-send, but they are uncoordinated and
# all poll — run replicas with WEBHOOKS_ENABLED=0 on all but one.
# WEBHOOKS_ENABLED=1

# Worker poll interval in ms (default 2000). The floor on delivery latency.
# WEBHOOKS_POLL_MS=2000

# Per-attempt HTTP timeout in ms (default 10000). Bounds how long one dead
# endpoint holds a worker, so batch size × this is the worst-case pass duration.
# WEBHOOKS_TIMEOUT_MS=10000

# DEV/DEMO ONLY. Permits an http:// webhook URL pointing at loopback so a local
# receiver can be registered. This is the single switch standing between an
# org-supplied URL and the operator's own localhost services — NEVER set it in
# production.
# WEBHOOKS_ALLOW_INSECURE=1

# ── Brand-logo upload hygiene ────────────────────────────────────────────────
# How old (ms) an UNPINNED brand-logo upload must be before the prune on
# POST /orgs/{id}/branding/logo will delete it. Default 60000 (60s).
#
# This is a SAFETY FLOOR, not a performance knob. Each upload reaps the ones it
# supersedes, and the age floor is the only thing stopping two SIMULTANEOUS
# uploads from deleting each other's freshly-stored document — the earlier
# request's row is not yet old enough to be a candidate. Set it below the time
# a request needs to store its own row and that data loss returns; set it to 0
# and the protection is off entirely (which is what the test harness does).
# Raising it is always safe: an abandoned pick just lingers until the next
# upload that happens after the window.
#
# Validated at boot — a non-numeric or negative value REFUSES TO START rather
# than silently disabling the prune (NaN) or making every row instantly
# reapable (negative).

# ── Error tracking (Sentry) ──────────────────────────────────────────────────
# Unset ⇒ observability is a total no-op (no network call, no dependency
# cost) — the default for local dev and tests. Set SENTRY_DSN to enable.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
#
# Defaults to NODE_ENV; set explicitly to tell deployments apart when several
# share one Sentry project (e.g. per persona container).
# SENTRY_ENVIRONMENT=pilot
# BRAND_LOGO_PRUNE_GRACE_MS=60000

# ── Outbound email (SMTP) ─────────────────────────────────────────────────────
# Unset SMTP_HOST defaults to localhost, which sends nowhere in production.
# SMTP_HOST=
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=
# MAIL_FROM=no-reply@tokenlayer.dev

# Base URL of the web app, embedded in every emailed link (password reset,
# welcome/set-password, org-approval, proposal-approval). Unset falls back to
# the first CORS_ORIGINS entry.
# PUBLIC_WEB_URL=
