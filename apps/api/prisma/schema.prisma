generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String
  useCaseKey   String?  // null = global Platform Admin
  accountId    String?  // wallet link for Buyer/Trader
  active       Boolean  @default(true)
  kycStatus    String   @default("approved")
  kyc          String?
  did          String?
  orgId            String?  // owning organization id (null for legacy/platform users)
  didSeedEncrypted String?  // AES-256-GCM encrypted Ed25519 seed for this user's sub-DID
  // "human" | "service" (EN-B). A service account is the principal an API key
  // becomes; it has no usable password and cannot log in interactively.
  kind         String   @default("human")
  createdAt    DateTime @default(now())
}

// An org-scoped machine credential (EN-B). The secret exists exactly once — in
// the create/rotate response — so only its bcrypt hash and a public prefix are
// stored: a leaked database yields no working credential.
model ApiKey {
  id         String    @id @default(cuid())
  orgId      String?   // null = platform-owned key (PlatformAdmin-minted)
  userId     String    // the bound SERVICE user this key authenticates as
  name       String
  prefix     String    @unique // first 8 chars of the secret — safe to display/index
  secretHash String    // bcrypt of the full secret; the secret itself is never stored
  scopes     String    // JSON string[]
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  revokedBy  String?
  createdBy  String
  createdAt  DateTime  @default(now())
  // EN-D2: "live" | "test". A tl_test_ key acts only on sandbox use cases.
  // Defaulting to "live" leaves every pre-EN-D2 key exactly as it was.
  mode       String    @default("live")

  @@index([orgId])
}

model Asset {
  id            String   @id
  useCaseKey    String
  name          String
  symbol        String
  chainId       String
  contractRef   String
  tokenType     String
  tokenStandard String   @default("ERC-20")
  metadata      String // JSON-encoded
  status          String   @default("active")
  createdBy       String
  createdAt       DateTime @default(now())
  unitPrice       String?
  currency        String?
  treasuryAccount String?
  // Value of the use case's `uniqueBy` metadata field (e.g. an invoice fingerprint),
  // if any. The (useCaseKey, uniqueKey) unique index is the atomic backstop that
  // makes "tokenize an invoice at most once" hold even under concurrent issue.
  // NULL for use cases without a uniqueBy rule (SQLite treats NULLs as distinct).
  uniqueKey       String?

  @@unique([useCaseKey, uniqueKey])
}

// Low-code use-case definitions, editable via the dashboard builder. JSON
// columns hold the structured config; the repository validates + normalises.
model UseCase {
  key             String   @id
  name            String
  description     String?
  tokenStandard   String
  symbol          String
  defaultChainId  String
  allowedChainIds String // JSON array
  contracts       String   @default("{}") // JSON-encoded map: chainId -> { contractRef, deployTxHash }
  metadataSchema  String // JSON object
  lifecycle       String // JSON object
  compliance      String // JSON object
  fees             String   @default("{}") // JSON object: { marketplaceBps?, issuanceFlat? }
  saleTermsDefault String   @default("{}") // JSON object: { unitPrice?, currency? }
  valuation        String   @default("{}") // JSON object: { metadataField, currency } (analytics valuation)
  derivedFields    String   @default("{}") // JSON object: metadataField -> generator (server-derived on issue)
  uniqueBy         String? // metadata field that must be unique across the use case's assets
  terms            String   @default("{}") // JSON object: { principalField, maturityField, rateField?, frequency?, currency }
  workflow         String   @default("{}") // JSON object: { approvals?: { [gatedOp]: requiredApprovals } }
  roles           String // JSON array
  ownerOrgId      String?  // owning organization id (null = legacy platform-owned)
  // EN-D2: a sandbox use case lives only on the `sandbox` chain and is reachable
  // only by a tl_test_ key. The DEFAULT is what makes this a zero-migration
  // change — every row written before the column existed reads back as live.
  sandbox         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// A configured credential (DID/VC) use case — the Identity-domain parallel of
// the tokenization UseCase. JSON columns hold the structured config.
model CredentialUseCase {
  key             String   @id
  name            String
  description     String?
  credentialTypes String   // JSON: CredentialTypeSpec[]
  issuer          String   // JSON: IssuerBinding
  holderPolicy    String   // JSON: HolderPolicy
  verifier        String   // JSON: VerifierBinding
  ownerOrgId      String?
  status          String   @default("active")
  holderAcceptance Boolean @default(false)
  // EN-D2 — the Identity-domain twin of UseCase.sandbox. Same zero-migration default.
  sandbox         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CredentialUseCaseTemplate {
  key         String   @id
  name        String
  category    String
  description String?
  parameters  String   // JSON: TemplateParam[]
  body        String   // JSON: UseCaseTemplate["body"]
  ownerOrgId  String?
  createdAt   DateTime @default(now())
}

// Append-only audit stream. assetId is an unconstrained reference (not a FK) so
// entries can be written before/after an asset row exists and survive its removal.
model AuditLog {
  id        String   @id @default(cuid())
  assetId   String?
  actorId   String
  action    String
  payload   String // JSON-encoded
  txHash    String?
  chainId   String?
  createdAt DateTime @default(now())
  seq       Int      @default(0)
  prevHash  String   @default("")
  hash      String   @default("")

  @@index([assetId])
  @@unique([assetId, seq])
}

// On-ledger anchor of an audit chain head: the operator broadcasts the head
// hash to the ledger so even a consistent full DB rewrite is caught (the stored
// hash for the anchored seq no longer matches the on-ledger txHash's payload).
model AuditAnchor {
  id        String   @id @default(cuid())
  assetId   String
  seq       Int
  hash      String
  txHash    String
  chainId   String
  createdAt DateTime @default(now())

  @@index([assetId])
}

// Secondary-market sell listing. `quantity` is the REMAINING quantity — it
// decrements on takes and the row flips to "filled" when it reaches 0.
model Listing {
  id        String   @id @default(cuid())
  assetId   String
  seller    String // wallet address
  quantity  String // REMAINING quantity (decrements on takes)
  unitPrice String
  currency  String
  status    String   @default("open") // open | filled | cancelled
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId, status])
}

model Account {
  id      String @id @default(cuid())
  address String @unique
  label   String
}

model CashBalance {
  id       String @id @default(cuid())
  currency String
  address  String
  amount   String @default("0")

  @@unique([currency, address])
}

// A materialized financial-terms cashflow (coupon or redemption) for one asset,
// created at issue from the use case's `terms`. Only "scheduled"/"executing"/
// "executed" are stored — "due"/"overdue" are derived from the date at read time.
model Cashflow {
  id         String    @id @default(cuid())
  assetId    String
  seq        Int
  kind       String // "coupon" | "redemption"
  dueDate    String // YYYY-MM-DD
  amount     String // integer decimal string
  currency   String
  status     String    @default("scheduled") // "scheduled" | "executing" | "executed"
  executedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([assetId, seq])
}

// Uploaded documents (e.g. invoice PDFs). Bytes are stored inline; the asset
// metadata references the document by its GET URL + sha256 hash.
model Document {
  id          String   @id @default(cuid())
  contentType String
  sha256      String
  size        Int
  bytes       Bytes
  createdAt   DateTime @default(now())
  // WHICH ORGANIZATION OWNS THESE BYTES, and NULL means NOBODY does — a
  // platform upload, a pre-org KYB registration, or a row written before this
  // column existed. Null is NOT "anyone may use it": every gate that consults
  // it requires a non-null match, so a legacy document can be referenced by a
  // PlatformAdmin and by no one else. Nullable rather than backfilled because
  // there is no honest way to guess the owner of an existing row.
  ownerOrgId  String?
  // WHAT THESE BYTES WERE UPLOADED FOR, and NULL means "an ordinary document" —
  // every upload site except the brand-logo door writes null, as does every row
  // written before this column existed. It is not decoration: it is the only
  // thing that distinguishes an organization's mark from its certificate
  // artwork, its KYB certificates and its invoice evidence, all of which are
  // also org-owned PNGs. `brand-logo` rows are the ONLY ones the prune in
  // `brand-logo-prune.ts` may delete, and a null row is therefore never swept —
  // there is no honest way to guess what a legacy row was for.
  purpose     String?
}

// A maker-checker proposal: a gated operation captured pending approval. The
// pending -> approved transition is a CAS (updateMany where-status) so
// concurrent Nth approvals execute the operation exactly once.
model Proposal {
  id            String    @id @default(cuid())
  useCaseKey    String? // null for non-token (e.g. credential) proposals
  orgId         String? // set for org-scoped kinds; null for token kinds
  assetId       String?
  kind          String // gated op: issue | mint | transfer | burn | freeze | unfreeze | cashflow-execute
  payload       String // JSON — everything the executor needs
  proposerId    String
  proposerLabel String // email, for display
  required      Int
  approvals     String    @default("[]") // JSON: [{ userId, email, at }]
  status        String    @default("pending") // pending | approved | rejected | executed | failed
  error         String?
  result        String? // JSON — optional executor report (e.g. CSV batch per-row outcomes)
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?

  @@index([useCaseKey, status])
  @@index([orgId, status])
}

// A tenant organization. Its parent did:key is custodial: didSeedEncrypted holds
// the AES-256-GCM encrypted Ed25519 seed the platform signs membership VCs with.
model Organization {
  id               String   @id @default(cuid())
  name             String   @unique
  orgType          String // bank | corporate | msme | government | verifier
  registrationId   String?
  jurisdiction     String?
  did              String   @unique
  didSeedEncrypted String
  status           String   @default("active") // active | suspended
  verified         Boolean  @default(false)
  verifiedAt       DateTime?
  companyProfile   String? // JSON-encoded CompanyProfile (India KYB details), self-registered corporates only
  capabilities     String? // EN-A: JSON OrgCapabilities envelope; null = unrestricted legacy
  brandLogoDocumentId String? // EN-E: an image Document id; null = the platform's own look
  brandAccent         String? // EN-E: #rrggbb; null = the platform's own palette
  createdAt        DateTime @default(now())

  @@index([status])
}

// A stored Verifiable Credential (VC-JWT) held by a subject DID. subjectClaims is
// the decoded credentialSubject (JSON) for quick display without re-decoding.
model Credential {
  id            String   @id @default(cuid())
  holderDid     String
  issuerDid     String
  type          String // e.g. "OrganizationMembership"
  vcJwt         String
  subjectClaims String // JSON-encoded credentialSubject
  issuedAt      DateTime @default(now())
  expiresAt     DateTime?
  revoked       Boolean  @default(false)
  revokedAt     DateTime?
  revokedReason String?
  revokedBy     String? // user id that proposed the revocation
  proposalId    String? // the approved request that produced this credential
  credentialUseCaseKey String? // the CredentialUseCase this VC was issued under, if any
  acceptance     String    @default("accepted") // accepted | pending | rejected | changes_requested
  acceptanceAt   DateTime?
  acceptanceNote String?
  // ID-O: receipts of the on-chain writes behind this credential (null when
  // issued/revoked without a registry, or before ID-O — no backfill).
  anchorTxHash  String?
  anchorChainId String?
  revokeTxHash  String?

  @@index([holderDid])
}

// The identity registries deployed on one chain. There is exactly one row per
// chain that hosts them (in practice: REGISTRY_CHAIN_ID, default "besu"). The
// row's existence IS the idempotency check for the boot-time deploy.
model RegistryDeployment {
  chainId      String   @id
  didRegistry  String
  vcRegistry   String
  deployTxHash String
  createdAt    DateTime @default(now())
}

// A verifier's request for the holder to present credentials. Holder consent (a
// single direct action, not maker-checker) triggers custodial VP signing.
model VerificationRequest {
  id                     String    @id @default(cuid())
  verifierOrgId          String
  holderDid              String
  requestedTypes         String // JSON array of credential-type strings
  purpose                String
  credentialUseCaseKey   String? // the CredentialUseCase scoping this request, if any
  challenge              String
  status                 String    @default("pending") // pending | consented | rejected | expired
  presentationVpJwt      String? // the holder-signed VP, set at consent
  consentedAt            DateTime?
  consentedCredentialIds String? // JSON array, set at consent
  verifierResult         String? // JSON verification result, set at verify
  verifiedAt             DateTime?
  createdAt              DateTime  @default(now())
  expiresAt              DateTime

  @@index([holderDid, status])
  @@index([verifierOrgId, status])
}

// An invoice staged (uploaded/ERP-imported/manually entered) before selective
// tokenization into an Asset via the invoice register.
model StagedInvoice {
  id             String    @id @default(cuid())
  useCaseKey     String
  source         String    // upload | erp | manual
  metadata       String    // JSON-encoded
  invoiceHash    String
  documentId     String?
  documentSha256 String?
  status         String    @default("staged") // staged | tokenized
  assetId        String?
  createdBy      String
  createdAt      DateTime  @default(now())
  tokenizedAt    DateTime?

  @@index([useCaseKey, status])
  @@index([useCaseKey, invoiceHash])
}

// A self-custody device login key: the public did:key of a browser-held Ed25519
// keypair, registered for passwordless login. The private key never leaves the device.
model LoginKey {
  id         String   @id @default(cuid())
  userId     String
  did        String   @unique
  label      String
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// EN-C event outbox. Deliberately NOT the audit log: AuditLog is per-asset
// hash-chained (@@unique([assetId, seq])) for HA-B tamper evidence, its seq is
// per-asset, and assetId is null for every credential/org row — so it has no
// global cursor. `seq` here is that cursor.
//
// `seq` is the @id because SQLite/Prisma only allow @default(autoincrement())
// on an Int @id. The public, stable identifier sent to integrators is `id`.
model Event {
  seq        Int      @id @default(autoincrement())
  id         String   @unique @default(cuid())
  type       String
  orgId      String? // the single owning org; null = platform-scope
  useCaseKey String?
  subjectId  String? // the credential / asset / verification this is about
  data       String // JSON-encoded, redacted payload
  occurredAt DateTime @default(now())
  // EN-D2: the mode of the use case this fact came from, denormalised so the
  // stream can be filtered without a join. Defaults to "live".
  mode       String   @default("live")

  @@index([orgId, seq])
  @@index([type])
}

// An org's declared interest. `secretEncrypted` is AES-256-GCM under
// WEBHOOK_MASTER_KEY (which falls back to DID_MASTER_KEY when unset, so an
// existing deployment needs no re-encryption), NOT a hash: HMAC signing must
// REPRODUCE the secret, so a one-way hash would make signing impossible.
//
// There is no key versioning and no re-encryption path, so CHANGING the key in
// place makes every stored secret unopenable. The dispatcher treats that as a
// platform fault — the attempt fails with an honest reason and disables nothing
// — but the deliveries do not recover until the old key is restored.
model WebhookEndpoint {
  id                       String    @id @default(cuid())
  orgId                    String? // null = platform-scope, PlatformAdmin only
  url                      String
  description              String?
  eventTypes               String // JSON string[]; ["*"] allowed
  useCaseKey               String?
  secretEncrypted          String
  status                   String    @default("active") // active | disabled
  disabledReason           String?
  disabledAt               DateTime?
  // Only failures we can attribute to THE ENDPOINT (non-2xx / unreachable) may
  // auto-disable it. Guard/DNS refusals are counted apart and disable nothing:
  // their cause is outside our trust boundary, so feeding them here would turn
  // our own SSRF defence into a way to silence an integrator.
  consecutiveFailures      Int       @default(0)
  consecutiveGuardFailures Int       @default(0)
  // Start of the CURRENT endpoint-failure run; null while healthy. The
  // auto-disable time floor reads this, which is what stops a backlog burst
  // (batch size and the threshold are both 20) from disabling in one pass.
  failingSince             DateTime?
  deletedAt                DateTime?
  createdBy                String
  createdAt                DateTime  @default(now())
  lastDeliveryAt           DateTime?
  // EN-D2: which stream this endpoint subscribes to. Defaults to "live", and is
  // never updated in place — an endpoint cannot cross the sandbox boundary.
  mode                     String    @default("live")

  @@index([orgId])
}

// One attempt chain for one (event, endpoint) pair. The unique pair is the
// fan-out idempotency key: re-emitting or re-fanning cannot double-enqueue.
model WebhookDelivery {
  id             String    @id @default(cuid())
  endpointId     String
  eventId        String
  eventSeq       Int
  status         String    @default("pending") // pending | inflight | delivered | failed | dead
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lastAttemptAt  DateTime?
  responseStatus Int?
  responseError  String?
  durationMs     Int?
  claimedAt      DateTime?
  claimedBy      String?
  createdAt      DateTime  @default(now())

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
}
