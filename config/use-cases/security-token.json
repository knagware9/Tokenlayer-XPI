{
  "key": "security-token",
  "name": "Security Token",
  "description": "A permissioned security token (ERC-3643 / T-REX style). Every holder must be identity-registered (allowlist is mandatory); supports freeze and operator recovery. A template for regulated equity or debt instruments.",
  "tokenStandard": "ERC-3643",
  "allowedChainIds": ["mock", "fabric", "canton", "local-evm", "besu", "mst"],
  "defaultChainId": "mock",
  "metadataSchema": {
    "type": "object",
    "properties": {
      "issuer": { "type": "string", "description": "Issuing entity" },
      "instrument": { "type": "string", "description": "e.g. equity / bond / fund unit" },
      "isin": { "type": "string", "description": "Optional securities identifier" }
    },
    "required": ["issuer", "instrument"]
  },
  "lifecycle": { "mint": true, "transfer": true, "burn": true, "freeze": true },
  "compliance": { "allowlist": true, "transferRestrictions": true },
  "roles": ["Admin", "Issuer", "Operator", "Viewer"]
}
