# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="dev-secret-change-me"

# API port
PORT=4000

# Optional EVM chains. Each is enabled only when its RPC URL is set. EVM_OPERATOR_KEY
# is the shared default operator (Hardhat account #0); per-chain keys override it.
# Start a local node with: pnpm --filter @tokenlayer/contracts node
EVM_OPERATOR_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# local-evm
# EVM_RPC_URL="http://127.0.0.1:8545"

# Hyperledger Besu (EVM)
# BESU_RPC_URL="http://127.0.0.1:8545"
# BESU_OPERATOR_KEY="0x..."

# MST Blockchain (public EVM)
# MST_RPC_URL="https://rpc.mst.example"
# MST_OPERATOR_KEY="0x..."
