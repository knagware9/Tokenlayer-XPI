{
  "name": "@tokenlayer/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push --skip-generate",
    "db:setup": "prisma generate && prisma db push --skip-generate",
    "seed": "tsx src/seed.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "demo": "tsx src/demo.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@prisma/client": "^5.22.0",
    "@tokenlayer/adapters": "workspace:*",
    "@tokenlayer/core": "workspace:*",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
